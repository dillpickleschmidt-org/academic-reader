# Development Configuration
# Copy to .env.local: cp .env.local.example .env.local

# ─────────────────────────────────────────────────────────────
# Backend choices
# ─────────────────────────────────────────────────────────────
# Conversion backend: local | datalab | modal
CONVERSION_BACKEND=local
# TTS backend: local | modal | none
TTS_BACKEND=local
# Storage backend: minio | r2
STORAGE_BACKEND=minio

# Frontend/API URL
SITE_URL=http://localhost:5173

# Convex URLs used by the API server and browser
CONVEX_API_URL=http://localhost:3210
CONVEX_HTTP_ACTIONS_URL=http://localhost:3211
PUBLIC_CONVEX_API_URL=http://localhost:3210

# ─────────────────────────────────────────────────────────────
# API Keys
# ─────────────────────────────────────────────────────────────
# Datalab - https://www.datalab.to/
# DATALAB_API_KEY=

# AI - shared keys
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# EXA_API_KEY=

# AI - chat model (chatbot)
# CHAT_PROVIDER= # google | openrouter (default: google)
# CHAT_MODEL= # default: gemini-3-flash-preview

# AI - processing model (TOC extraction, TTS block filter, TTS rewrite)
# PROCESSING_PROVIDER= # google | openrouter | groq (default: google)
# PROCESSING_MODEL= # default: gemini-3-flash-preview

# AI - summary model (document summarization)
# SUMMARY_PROVIDER= # google | openrouter | groq (default: google)
# SUMMARY_MODEL= # default: gemini-3-flash-preview

# ─────────────────────────────────────────────────────────────
# Modal Backend (for CONVERSION_BACKEND=modal or TTS_BACKEND=modal)
# bun run infra / bun run modal:setup can discover or deploy these for you.
# ─────────────────────────────────────────────────────────────
# MODAL_MARKER_URL=https://your-modal-app--marker-api.modal.run
# MODAL_LIGHTONOCR_URL=https://your-modal-app--lightonocr-api.modal.run
# MODAL_CHANDRA_URL=https://your-modal-app--chandra-api.modal.run
# MODAL_KOKORO_TTS_URL=https://your-modal-app--kokoro-tts-api.modal.run
# MODAL_QWEN3_TTS_URL=https://your-modal-app--qwen3-tts-api.modal.run

# ─────────────────────────────────────────────────────────────
# OAuth (optional, for Google sign-in)
# ─────────────────────────────────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────
# Auto-generated by bun run infra (do not set manually)
# ─────────────────────────────────────────────────────────────
# BETTER_AUTH_SECRET=
# API_TO_CONVEX_SERVICE_SECRET=
# CONVEX_SELF_HOSTED_ADMIN_KEY=

# ─────────────────────────────────────────────────────────────
# Production bootstrap input (for bun run setup:prod)
# ─────────────────────────────────────────────────────────────
PROD_DOMAIN=your-domain.com

# ─────────────────────────────────────────────────────────────
# Local Infrastructure (MinIO S3 + Convex, started via bun run infra)
# ─────────────────────────────────────────────────────────────
S3_API_ENDPOINT=http://localhost:9000
S3_PRESIGNED_URL_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=academic-reader
