# Production Environment Variables
# These are set in Dokploy UI, not in a file on the VPS.
# This file serves as documentation for required variables.

# ─────────────────────────────────────────────────────────────
# App Container (set in Dokploy)
# ─────────────────────────────────────────────────────────────
BACKEND_MODE=modal # or datalab
SITE_URL=https://academic-reader.com
# example:  CONVEX_SITE_URL=http://academicreader-convex-aesgkq-backend-1:3210
# example:  CONVEX_HTTP_URL=http://academicreader-convex-aesgkq-backend-1:3211

# Datalab mode:
# DATALAB_API_KEY=

# AI - shared keys
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# EXA_API_KEY=

# AI - chat model (chatbot)
# CHAT_PROVIDER= # google | openrouter (default: google)
# CHAT_MODEL= # default: gemini-3-flash-preview

# AI - processing model (TOC extraction, TTS block filter, TTS rewrite)
# PROCESSING_PROVIDER= # google | openrouter | groq (default: groq)
# PROCESSING_MODEL= # default: meta-llama/llama-4-scout-17b-16e-instruct

# AI - summary model (document summarization)
# SUMMARY_PROVIDER= # google | openrouter | groq (default: google)
# SUMMARY_MODEL= # default: gemini-3-flash-preview

# Modal mode:
# MODAL_MARKER_URL=https://your-modal-app--marker-api.modal.run
# MODAL_LIGHTONOCR_URL=https://your-modal-app--lightonocr-api.modal.run
# MODAL_CHANDRA_URL=https://your-modal-app--chandra-api.modal.run
# MODAL_KOKORO_TTS_URL=https://your-modal-app--kokoro-tts-api.modal.run
# MODAL_QWEN3_TTS_URL=https://your-modal-app--qwen3-tts-api.modal.run

# OpenTelemetry (logs to Grafana/Loki via Alloy)
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318

# S3 Storage (required for Modal mode)
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=
# S3_PUBLIC_URL=

# ─────────────────────────────────────────────────────────────
# Convex Container (set in Dokploy)
# ─────────────────────────────────────────────────────────────
# CONVEX_CLOUD_ORIGIN=https://convex-api.academic-reader.com
# CONVEX_SITE_ORIGIN=https://convex-http-actions.academic-reader.com
# DISABLE_BEACON=true

# ─────────────────────────────────────────────────────────────
# GitHub Secrets (for GitHub Actions)
# ─────────────────────────────────────────────────────────────
# DOCKERHUB_USERNAME
# DOCKERHUB_TOKEN
# CONVEX_ADMIN_KEY
# GOOGLE_CLIENT_ID
# GOOGLE_CLIENT_SECRET
# BETTER_AUTH_SECRET
# MODAL_TOKEN_ID
# MODAL_TOKEN_SECRET
