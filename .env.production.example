# Production Environment Variables
# Generated by: bun run setup:prod
# This file documents the values written to .env.production.

# ─────────────────────────────────────────────────────────────
# Deployment
# ─────────────────────────────────────────────────────────────
PROD_DOMAIN=academic-reader.example.com
APP_DOMAIN=academic-reader.example.com
CONVEX_DOMAIN=convex.academic-reader.example.com
FILES_DOMAIN=files.academic-reader.example.com
SITE_URL=https://academic-reader.example.com
PUBLIC_CONVEX_API_URL=https://convex.academic-reader.example.com

# Internal Docker URLs
CONVEX_API_URL=http://convex-backend:3210
CONVEX_HTTP_ACTIONS_URL=http://convex-backend:3211

# Backends
# CONVERSION_BACKEND: datalab | modal
CONVERSION_BACKEND=datalab
# TTS_BACKEND: none | modal
TTS_BACKEND=none
STORAGE_BACKEND=minio

# ─────────────────────────────────────────────────────────────
# Auto-generated by setup (do not invent manually)
# ─────────────────────────────────────────────────────────────
# BETTER_AUTH_SECRET=
# API_TO_CONVEX_SERVICE_SECRET=
# CONVEX_SELF_HOSTED_ADMIN_KEY=
# MINIO_ROOT_USER=
# MINIO_ROOT_PASSWORD=

# MinIO/S3
S3_API_ENDPOINT=http://minio:9000
S3_PRESIGNED_URL_ENDPOINT=https://files.academic-reader.example.com
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
S3_BUCKET=academic-reader

# ─────────────────────────────────────────────────────────────
# Dashboard-provided keys
# ─────────────────────────────────────────────────────────────
# Required for the default AI configuration and document embeddings:
# GOOGLE_API_KEY=

# Required when CONVERSION_BACKEND=datalab:
# DATALAB_API_KEY=

# Required when CONVERSION_BACKEND=modal:
# MODAL_MARKER_URL=https://your-modal-app--marker-api.modal.run
# MODAL_LIGHTONOCR_URL=https://your-modal-app--lightonocr-api.modal.run
# MODAL_CHANDRA_URL=https://your-modal-app--chandra-api.modal.run

# Required when TTS_BACKEND=modal:
# MODAL_KOKORO_TTS_URL=https://your-modal-app--kokoro-tts-api.modal.run
# MODAL_QWEN3_TTS_URL=https://your-modal-app--qwen3-tts-api.modal.run

# Optional OAuth (Google sign-in):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional AI providers/features:
# EXA_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# AI_PROVIDER=groq
# AI_MODEL=openai/gpt-oss-120b

# Optional logs to Grafana/Loki via Alloy:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
