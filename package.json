{
  "name": "academic-reader",
  "private": true,
  "packageManager": "bun@1.3.9",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev --ui tui",
    "dev:api": "turbo dev --filter=@academic-reader/api",
    "dev:web": "turbo dev --filter=@academic-reader/web",
    "build": "turbo build",
    "check": "turbo check",
    "check:api": "turbo check --filter=@academic-reader/api",
    "check:web": "turbo check --filter=@academic-reader/web",
    "infra": "bun scripts/infra.ts up",
    "infra:down": "bun scripts/infra.ts down",
    "modal:setup": "bun scripts/modal.ts setup",
    "modal:print": "bun scripts/modal.ts print",
    "setup:prod": "bun scripts/prod.ts setup",
    "prod:up": "bun scripts/prod.ts up",
    "prod:down": "bun scripts/prod.ts down",
    "prod:sync-convex": "bun scripts/prod.ts sync-convex",
    "prod:print": "bun scripts/prod.ts print",
    "prod:doctor": "bun scripts/prod.ts doctor"
  },
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "turbo": "^2.5.3",
    "typescript": "~5.9.3"
  }
}
